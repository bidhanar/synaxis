# Generates a C++ source holding the web UI files as byte arrays.
# Invoked in script mode: cmake -DOUTPUT=... -DROOT=... -DFILES=a,b,c -P EmbedAssets.cmake

string(REPLACE "," ";" FILES "${FILES}")

set(body "// Generated by cmake/EmbedAssets.cmake. Do not edit.\n")
string(APPEND body "#include \"web_assets.hpp\"\n\nnamespace synaxis::web {\nnamespace {\n")

set(table "")
set(index 0)
foreach(name IN LISTS FILES)
    file(READ "${ROOT}/${name}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
    string(APPEND body "const unsigned char kData${index}[] = {${hex}};\n")

    get_filename_component(ext "${name}" LAST_EXT)
    if(ext STREQUAL ".html")
        set(mime "text/html; charset=utf-8")
    elseif(ext STREQUAL ".css")
        set(mime "text/css; charset=utf-8")
    elseif(ext STREQUAL ".js")
        set(mime "text/javascript; charset=utf-8")
    elseif(ext STREQUAL ".svg")
        set(mime "image/svg+xml")
    else()
        set(mime "application/octet-stream")
    endif()
    string(APPEND table "    {\"/${name}\", \"${mime}\", kData${index}, sizeof(kData${index})},\n")
    math(EXPR index "${index} + 1")
endforeach()

string(APPEND body "} // namespace\n\nconst Asset kAssets[] = {\n${table}};\n")
string(APPEND body "const std::size_t kAssetCount = ${index};\n\n} // namespace synaxis::web\n")

file(WRITE "${OUTPUT}.tmp" "${body}")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
