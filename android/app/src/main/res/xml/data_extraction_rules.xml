<?xml version="1.0" encoding="utf-8"?>
<!-- Back up profiles, history and settings; thumbnails are rebuilt on demand. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="thumbs/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="thumbs/" />
    </device-transfer>
</data-extraction-rules>
